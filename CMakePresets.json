{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "android-arm64-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
                "CMAKE_ANDROID_NDK_TOOLCHAIN_VERSION": "clang",
                "CMAKE_SYSTEM_VERSION": "28",
                "ANDROID_PLATFORM": "android-28",
                "ANDROID_ABI": "arm64-v8a",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android ARM64 (Multi-Config)",
            "description": "Android aarch64 build for devices running Android API 28+",
            "inherits": "android-arm64-base"
        },
        {
            "name": "android-arm64-debug",
            "displayName": "Android ARM64 Debug",
            "description": "Android aarch64 Debug build",
            "inherits": "android-arm64-base",
            "cacheVariables": {
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "android-arm64-release",
            "displayName": "Android ARM64 Release",
            "description": "Android aarch64 Release build with optimizations",
            "inherits": "android-arm64-base",
            "cacheVariables": {
                "CMAKE_DEFAULT_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android-arm64-debug",
            "displayName": "Build Android ARM64 Debug",
            "configurePreset": "android-arm64",
            "configuration": "Debug"
        },
        {
            "name": "android-arm64-release",
            "displayName": "Build Android ARM64 Release",
            "configurePreset": "android-arm64",
            "configuration": "Release"
        }
    ]
}
