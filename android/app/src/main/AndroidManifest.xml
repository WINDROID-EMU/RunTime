<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Permissions
         ============================================================ -->

    <!-- Vulkan GPU rendering (implicit, but declared for clarity) -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />

    <!-- Gamepad support (optional) -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Internet for future online features / telemetry (optional) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage: read game files on Android 9-12 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Storage: broad access for game data on Android 11+ (alternative to SAF) -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Keep CPU awake during gameplay -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service for long shader compilation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ============================================================
         Application
         ============================================================ -->
    <application
        android:name=".RexGlueApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReXGlue"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="35">

        <!-- ========================================================
             Main Activity — Game Launcher / Library
             ======================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================================================
             Game Activity — Full-screen game rendering
             ======================================================== -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:theme="@style/Theme.ReXGlue.Fullscreen"
            android:immersive="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:resizeableActivity="false"
            tools:targetApi="35">
            <!-- Keep screen on during gameplay -->
            <meta-data
                android:name="android.app.keep_screen_on"
                android:value="true" />
        </activity>

        <!-- ========================================================
             Settings Activity
             ======================================================== -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:parentActivityName=".MainActivity" />

        <!-- ========================================================
             Foreground Service for shader compilation
             ======================================================== -->
        <service
            android:name=".ShaderCompilationService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- File provider for sharing crash logs / saves -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
